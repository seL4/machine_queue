if [ ! "${SCRIPT_PATH}" ]; then
    echo "This script should not be called directly! Please use mq.sh"
    exit 1
fi

LockOwner() {
    machine-locks-client sem info "$1" --json | jq -r '.[0].owner//""'
}


LockIOwn() {
    owner="$(LockOwner "$1")"
    [ "${owner}" = "${REMOTEUSER}" ]
}


GetAllLockedSystems() {
    machine-locks-client machines list-locked --json | jq -r '.[].name'
}
